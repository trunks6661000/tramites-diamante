# ============ App ============
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_largo
TIMEZONE=America/Mexico_City
NODE_ENV=development

# ============ Database ============
# Postgres connection string. Railway/Neon/Supabase work out of the box.
DATABASE_URL=postgresql://usuario:password@localhost:5432/tramites_diamante?schema=public

# ============ SMTP / Email ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="Tramites Diamante <no-reply@tramitesdiamante.mx>"

# ============ WhatsApp ============
# Driver: 'walink' | 'meta' | 'twilio'
WHATSAPP_DRIVER=walink
WHATSAPP_PROVIDER_PHONE=521XXXXXXXXXX
# Meta Cloud API (si WHATSAPP_DRIVER=meta)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TEMPLATE_NAME=
# Twilio (si WHATSAPP_DRIVER=twilio)
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=

# ============ Storage (S3 compatible) ============
# Funciona con AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
STORAGE_DRIVER=s3
S3_BUCKET=tramites-diamante
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo para R2/MinIO/otros endpoints custom
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Tiempo de expiración de URLs firmadas en segundos
S3_SIGNED_URL_TTL=300

# ============ Defaults bootstrap ============
# Se usan en el seed inicial
SEED_ADMIN_EMAIL=admin@tramitesdiamante.mx
SEED_ADMIN_PASSWORD=Diamante123!
SEED_PROVEEDOR_EMAIL=proveedor@tramitesdiamante.mx
SEED_PROVEEDOR_PASSWORD=Proveedor123!
